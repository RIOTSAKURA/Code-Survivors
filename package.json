{
  "name": "code-survivors",
  "private": true,
  "version": "1.10.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "A code-themed Vampire Survivors style auto-shooter built with Phaser 3",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "font:subset": "node scripts/subset-cjk.mjs",
    "icon:build": "node scripts/build-icon.mjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && npm run icon:build && electron-builder --dir --publish never",
    "desktop:dist": "npm run build && npm run icon:build && electron-builder --publish never",
    "desktop:smoke": "node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
